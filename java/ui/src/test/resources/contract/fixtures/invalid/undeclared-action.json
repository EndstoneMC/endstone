{
  "schemaVersion": "1.0",
  "engine": "zernyth",
  "id": "lobby_ui",
  "name": "Lobby UI",
  "target": {
    "minEngineVersion": [
      1,
      21,
      0
    ],
    "zernythVersion": "0.9.0-alpha.1"
  },
  "pack": {
    "headerUuid": "2f1c7e2a-6b0d-4c55-9a51-0d2b6f3e9a11",
    "moduleUuid": "8a4b9c3d-1e2f-4a5b-8c6d-7e8f9a0b1c2d",
    "version": [
      1,
      0,
      0
    ]
  },
  "startScreen": "main_menu",
  "assets": [
    {
      "id": "coin",
      "name": "Coin",
      "path": "textures/zernyth_ui/coin",
      "width": 16,
      "height": 16,
      "source": "builtin",
      "sourceId": "coin"
    }
  ],
  "actions": [
    {
      "name": "shop.open",
      "description": "Opens the shop"
    },
    {
      "name": "shop.buy",
      "permission": "lobby.shop"
    }
  ],
  "screens": [
    {
      "id": "main_menu",
      "title": "Main Menu",
      "kind": "action_form",
      "content": "Welcome, {player.name}!",
      "canvas": {
        "width": 640,
        "height": 360,
        "background": "#16131f"
      },
      "components": [
        {
          "id": "title",
          "type": "text",
          "x": 20,
          "y": 20,
          "width": 300,
          "height": 30,
          "text": "Main Menu"
        },
        {
          "id": "shop_button",
          "type": "image_button",
          "x": 20,
          "y": 80,
          "width": 200,
          "height": 40,
          "text": "Shop",
          "icon": "coin",
          "action": {
            "type": "server_event",
            "name": "shop.steal"
          }
        },
        {
          "id": "settings_button",
          "type": "button",
          "x": 20,
          "y": 130,
          "width": 200,
          "height": 40,
          "text": "Settings",
          "action": {
            "type": "navigate",
            "target": "settings"
          }
        },
        {
          "id": "close_button",
          "type": "button",
          "x": 20,
          "y": 180,
          "width": 200,
          "height": 40,
          "text": "Close",
          "action": {
            "type": "close"
          }
        }
      ]
    },
    {
      "id": "settings",
      "title": "Settings",
      "kind": "modal_form",
      "canvas": {
        "width": 640,
        "height": 360
      },
      "submit": {
        "type": "server_event",
        "name": "shop.buy"
      },
      "components": [
        {
          "id": "music",
          "type": "toggle",
          "x": 20,
          "y": 20,
          "width": 200,
          "height": 30,
          "text": "Music",
          "value": 1
        },
        {
          "id": "volume",
          "type": "slider",
          "x": 20,
          "y": 60,
          "width": 200,
          "height": 30,
          "text": "Volume",
          "value": 50,
          "max": 100
        },
        {
          "id": "mode",
          "type": "dropdown",
          "x": 20,
          "y": 100,
          "width": 200,
          "height": 30,
          "text": "Mode",
          "options": [
            "Easy",
            "Hard"
          ]
        },
        {
          "id": "nick",
          "type": "text_field",
          "x": 20,
          "y": 140,
          "width": 200,
          "height": 30,
          "text": "Nickname",
          "placeholder": "Your name"
        }
      ]
    },
    {
      "id": "confirm_buy",
      "title": "Confirm",
      "kind": "message_form",
      "content": "Buy this item?",
      "canvas": {
        "width": 640,
        "height": 360
      },
      "components": [
        {
          "id": "yes",
          "type": "button",
          "x": 20,
          "y": 20,
          "width": 100,
          "height": 30,
          "text": "Buy",
          "action": {
            "type": "server_event",
            "name": "shop.buy"
          }
        },
        {
          "id": "no",
          "type": "button",
          "x": 140,
          "y": 20,
          "width": 100,
          "height": 30,
          "text": "Cancel",
          "action": {
            "type": "navigate",
            "target": "main_menu"
          }
        }
      ]
    }
  ],
  "$expect": "undeclared_action"
}